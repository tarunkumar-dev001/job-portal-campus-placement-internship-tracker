# Copy to .env for local use; never commit populated .env files.
PORT=8080
DB_URL=jdbc:mysql://db-host:3306/careerconnect?serverTimezone=UTC
DB_USERNAME=careerconnect_app
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
JPA_DDL_AUTO=validate
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_EXPIRATION_MS=900000
CORS_ALLOWED_ORIGINS=http://localhost:5173
RESUME_STORAGE_PATH=./var/resumes

# Required with SPRING_PROFILES_ACTIVE=prod. Mail is sent through the Mailjet HTTPS API.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CareerConnect
FRONTEND_VERIFICATION_URL=https://your-frontend-domain.example/verify-email
FRONTEND_PASSWORD_RESET_URL=https://your-frontend-domain.example/reset-password

# Required only with SPRING_PROFILES_ACTIVE=prod:
DB_SSL_TRUSTSTORE_PATH=/tmp/tidb-cloud-truststore.p12
DB_SSL_TRUSTSTORE_PASSWORD=

# Local demo profile only. Set a private password and explicitly opt in before starting with SPRING_PROFILES_ACTIVE=demo.
APP_DEMO_SEED_ENABLED=false
DEMO_PASSWORD=

# Frontend (set in frontend/.env.local or the frontend hosting provider):
VITE_API_BASE_URL=http://localhost:8080/api
